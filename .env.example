# KAIDO environment configuration.
# Copy to .env and fill in. NEVER commit the real .env file.
#
# All values are read at runtime only. No secret is ever hard-coded in source.

# ── AI provider ───────────────────────────────────────────────────────────────
# Default provider: gemini
KAIDO_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional per-provider keys if you enable others in src/ai/providers.ts
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Base URL for an OpenAI-compatible endpoint (e.g. a local model in Termux)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── Integrations (all optional; integration tools report "unavailable" when unset) ─
GITHUB_TOKEN=
GITHUB_OWNER=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# ── Termux bridge ─────────────────────────────────────────────────────────────
# KAIDO validates every shell command against an allowlist before execution.
KAIDO_TERMUX_ENABLED=false
KAIDO_TERMUX_PROJECT_ROOT=

# Bridge client (when the runtime is NOT on the phone itself).
KAIDO_TERMUX_BRIDGE_URL=http://127.0.0.1:7077
KAIDO_TERMUX_BRIDGE_TOKEN=

# ── Adapters ──────────────────────────────────────────────────────────────────
# Mount the files (scoped), web (fetch + extract), and termux adapters.
KAIDO_ADAPTERS=false

# Web search needs a provider; extraction works without one.
KAIDO_WEB_SEARCH_URL=
KAIDO_WEB_SEARCH_KEY=

# ── Runtime ───────────────────────────────────────────────────────────────────
# Directory for the JSON-backed audit log and memory store.
KAIDO_DATA_DIR=./kaido-data
KAIDO_LOG_LEVEL=info
